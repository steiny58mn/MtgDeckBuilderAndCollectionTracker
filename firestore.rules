rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users (including anonymous auth) full read/write to their user data and sync profiles
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || resource == null || resource.data.syncKey != null);
    }
    match /sync_vaults/{vaultId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /decks/{deckId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /collections/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
